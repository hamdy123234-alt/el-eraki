---
import '@fontsource-variable/alexandria';
import '../styles/global.css';
import '../styles/shop.css';
import Logo from '../components/Logo.astro';
import site from '../data/site.json';
import products from '../data/products.json';
import services from '../data/services.json';
import catalog from '../data/catalog.json';

const catName = Object.fromEntries(catalog.categories.map((c) => [c.id, c.name]));
const shopItems = catalog.products.filter((p) => p.img);
const catCount = (id) => shopItems.filter((p) => p.cat === id).length;
const shopCats = catalog.categories.filter((c) => catCount(c.id) > 0);

const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (path) => B + path.replace(/^\//, '');
const wa = (text) => `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(text)}`;
const first = products[0];

const icons = {
  laptop: '<path d="M5 6h22v14H5z"/><path d="M2 24h28l-2 3H4z"/>',
  pc: '<rect x="4" y="4" width="11" height="24" rx="2"/><circle cx="9.5" cy="10" r="2"/><path d="M7 20h5M18 8h10v12H18zM21 24h4"/>',
  monitor: '<rect x="3" y="5" width="26" height="17" rx="2"/><path d="M12 27h8M16 22v5"/>',
  cam: '<path d="M4 10l18-5 3 9-18 5z"/><path d="M10 18l2 6h-6M22 9l6-2"/><circle cx="11" cy="12" r="1.5"/>',
  wifi: '<path d="M3 12a19 19 0 0 1 26 0M7 16.5a13 13 0 0 1 18 0M11 21a7 7 0 0 1 10 0"/><circle cx="16" cy="25" r="1.6"/>',
  tool: '<path d="M20 4a6 6 0 0 0-5 8L4 23l5 5 11-11a6 6 0 0 0 8-5l-4 1-3-3z"/>',
  sound: '<rect x="7" y="3" width="18" height="26" rx="3"/><circle cx="16" cy="19" r="5"/><circle cx="16" cy="9" r="2"/>',
  mouse: '<rect x="9" y="3" width="14" height="26" rx="7"/><path d="M16 3v8"/>',
  print: '<path d="M9 12V4h14v8M9 23H5V12h22v11h-4"/><path d="M9 18h14v10H9z"/>',
  dish: '<path d="M6 8a14 14 0 0 0 18 18z"/><path d="M15 17l8-8M24 9l2-2"/><path d="M11 27h10"/>',
};
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{site.fullName} | لابتوبات وكمبيوتر وكاميرات مراقبة — السنطة</title>
  <meta name="description" content={`${site.fullName} — ${site.tagline}. لابتوبات Dell و HP، تجميعات جيمنج، شاشات، كاميرات مراقبة، شبكات وصيانة في ${site.address}.`} />
  <meta name="theme-color" content="#050a1f" />
  <link rel="icon" href={asset("favicon.png")} />
  <meta property="og:title" content={site.fullName} />
  <meta property="og:description" content={site.tagline} />
  <meta property="og:image" content={asset("img/store.webp")} />
</head>
<body style={`--accent:${first.accent}`}>

  <!-- intro -->
  <div class="intro" aria-hidden="true">
    <div class="intro-inner">
      <Logo size={120} class="intro-logo" />
      <div class="intro-word">العراقي</div>
    </div>
  </div>

  <div class="progress" aria-hidden="true"></div>
  <div class="cursor-glow" aria-hidden="true"></div>

  <!-- header -->
  <header class="nav">
    <a href="#top" class="brand">
      <Logo size={40} />
      <span class="brand-txt"><b>{site.name}</b><small>للخدمات التكنولوجية</small></span>
    </a>
    <nav class="nav-links">
      <a href="#laptops">اللابتوبات</a>
      <a href="#shop">المتجر</a>
      <a href="#services">خدماتنا</a>
      <a href="#story">مين إحنا</a>
      <a href="#contact">تواصل</a>
    </nav>
    <a class="btn btn-gold btn-sm" href={wa('أهلاً العراقي، عايز أستفسر عن جهاز')} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.3 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.4Z"/></svg>
      <span>اطلب دلوقتي</span>
    </a>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero" data-hero>
      <div class="hero-bg" aria-hidden="true">
        <div class="grid-floor"></div>
        <div class="blob"></div>
        <div class="giant">العراقي</div>
      </div>

      <div class="hero-copy">
        <p class="eyebrow"><span class="dot"></span> {site.address} · منذ أول يوم أجهزة أصلية</p>
        <h1 class="hero-title">
          <span class="line"><span>جهازك الجاي</span></span>
          <span class="line"><span>عند <em>العراقي</em></span></span>
        </h1>
        <p class="hero-sub">{site.tagline}. لابتوبات Dell و HP مختارة جهاز جهاز، وكل اللي محتاجه في التكنولوجيا تحت سقف واحد.</p>
        <div class="hero-cta">
          <a class="btn btn-gold" href="#laptops">شوف الأجهزة</a>
          <a class="btn btn-ghost" href={`tel:${site.phone.replace(/\s/g,'')}`}><bdi dir="ltr">{site.phone}</bdi></a>
        </div>
      </div>

      <div class="stage" data-stage>
        <div class="model-word" data-model-word>{first.model}</div>
        <div class="laptop-wrap" data-tilt>
          {products.map((p, i) => (
            <img class={`laptop ${i === 0 ? 'is-on' : ''}`} data-i={i} src={asset(p.img)} alt={`${p.brand} ${p.series} ${p.model}`} width="840" height="550" loading={i === 0 ? 'eager' : 'lazy'} />
          ))}
          <div class="reflection" aria-hidden="true"></div>
        </div>
        <ul class="chips" data-chips>
          {first.specs.slice(0, 4).map((s) => (
            <li><small>{s[0]}</small><b>{s[1]}</b></li>
          ))}
        </ul>
      </div>

      <div class="switcher">
        <button class="arrow" data-prev aria-label="الجهاز السابق">→</button>
        <div class="thumbs">
          {products.map((p, i) => (
            <button class={`thumb ${i === 0 ? 'is-on' : ''}`} data-go={i} style={`--c:${p.accent}`} aria-label={`${p.brand} ${p.model}`}>
              <span class="t-brand">{p.brand}</span><span class="t-model">{p.model}</span>
            </button>
          ))}
        </div>
        <button class="arrow" data-next aria-label="الجهاز التالي">←</button>
      </div>

      <div class="scroll-hint" aria-hidden="true"><span></span>انزل</div>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {services.map((s) => (<span>{s.title}<i>✦</i></span>))}
          </div>
        ))}
      </div>
    </div>

    <!-- LAPTOPS -->
    <section class="laptops" id="laptops">
      <div class="sec-head">
        <span class="sec-num">01</span>
        <h2 class="sec-title reveal">اللابتوبات <span class="outline">المتاحة</span></h2>
        <p class="sec-lead reveal">أجهزة فئة الأعمال اللي بتعيش. اختار جهازك وابعتلنا على واتساب، وهنرد عليك بالسعر والتفاصيل.</p>
      </div>

      <div class="rail-pin" data-rail-pin>
        <div class="rail" data-rail>
          {products.map((p, i) => (
            <article class="pcard" style={`--c:${p.accent}`}>
              <div class="pcard-top">
                <span class="pcard-idx">0{i + 1}</span>
                <span class="pcard-tag">{p.tag}</span>
              </div>
              <div class="pcard-visual">
                <div class="pcard-glow"></div>
                <span class="pcard-bigmodel">{p.model}</span>
                <img src={asset(p.img)} alt={`${p.brand} ${p.model}`} loading="lazy" width="840" height="550" />
              </div>
              <h3 class="pcard-name"><small>{p.brand} {p.series}</small>{p.model}</h3>
              <ul class="pcard-specs">
                {p.specs.map((s) => (
                  <li><span>{s[0]}</span><b>{s[1]}{s[2] && <em> · {s[2]}</em>}</b></li>
                ))}
              </ul>
              <div class="pcard-foot">
                <span class="price">{p.price || 'السعر على واتساب'}</span>
                <a class="btn btn-gold btn-sm" target="_blank" rel="noopener" href={wa(`أهلاً العراقي، عايز أسأل عن لابتوب ${p.brand} ${p.series} ${p.model} (${p.specs.map(s=>s[1]).join(' / ')}) — متاح وبكام؟`)}>اطلبه</a>
              </div>
            </article>
          ))}
          <article class="pcard pcard-more">
            <h3>مش لاقي<br/>اللي في دماغك؟</h3>
            <p>قولنا ميزانيتك واستخدامك، وإحنا نختارلك الجهاز المناسب.</p>
            <a class="btn btn-gold" target="_blank" rel="noopener" href={wa('أهلاً العراقي، محتاج لابتوب. ميزانيتي ... واستخدامي ...')}>ساعدني أختار</a>
          </article>
        </div>
      </div>
    </section>


    <!-- SHOP -->
    <section class="shop" id="shop">
      <div class="sec-head">
        <span class="sec-num">02</span>
        <h2 class="sec-title reveal">المتجر <span class="outline">كله في إيدك</span></h2>
        <p class="sec-lead reveal">{shopItems.length}+ منتج من سماعات وجيمنج وصوتيات العربية لحد الشبكات والتخزين. ضيف اللي محتاجه للسلة وابعت الطلب على واتساب مرة واحدة.</p>
      </div>

      <div class="shop-bar">
        <label class="search">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" placeholder="دوّر على منتج، ماركة أو موديل…" data-search aria-label="بحث في المنتجات" />
        </label>
        <div class="chips-row" data-cats>
          <button class="cat is-on" data-cat="all">الكل <i>{shopItems.length}</i></button>
          {shopCats.map((c) => (
            <button class="cat" data-cat={c.id}>{c.name} <i>{catCount(c.id)}</i></button>
          ))}
        </div>
      </div>

      <div class="grid" data-grid>
        {shopItems.map((p, i) => (
          <article class="card" data-id={p.id} data-cat={p.cat} data-text={`${p.name} ${p.brand} ${p.model} ${catName[p.cat]} ${p.tags.join(' ')}`.toLowerCase()} tabindex="0">
            <div class="card-media">
              <img src={asset(`img/n/${p.id}.webp`)} alt={`${p.brand} ${p.model} — ${p.name}`} loading={i < 8 ? 'eager' : 'lazy'} width="600" height="600" />
            </div>
            <div class="card-body">
              <span class="card-brand">{p.brand}</span>
              <h3 class="card-name">{p.name}</h3>
              <span class="card-model">{p.model}</span>
              <div class="card-tags">{p.tags.slice(0, 2).map((t) => <span>{t}</span>)}</div>
            </div>
            <div class="card-foot">
              <span class="card-price">السعر على واتساب</span>
              <button class="add" data-add={p.id} aria-label={`أضف ${p.name} للسلة`}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
              </button>
            </div>
          </article>
        ))}
      </div>
      <p class="empty" data-empty hidden>مفيش منتج بالاسم ده… <a target="_blank" rel="noopener" href={wa('أهلاً العراقي، بدوّر على منتج: ')}>اسألنا على واتساب</a> وأكيد هنلاقيهولك.</p>
      <div class="more-wrap"><button class="btn btn-ghost" data-more>عرض كل المنتجات</button></div>
    </section>

    <!-- SERVICES -->
    <section class="services" id="services">
      <div class="sec-head">
        <span class="sec-num">03</span>
        <h2 class="sec-title reveal">كل التكنولوجيا <span class="outline">تحت سقف واحد</span></h2>
      </div>
      <div class="bento">
        {services.map((s) => (
          <a class={`tile ${s.big ? 'tile-big' : ''}`} target="_blank" rel="noopener" href={wa(`أهلاً العراقي، عايز أستفسر عن: ${s.title}`)}>
            <span class="tile-n">{s.n}</span>
            <svg class="tile-ico" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
            <h3>{s.title}</h3>
            <p>{s.sub}</p>
            <span class="tile-go">اسأل ←</span>
          </a>
        ))}
      </div>
    </section>

    <!-- STORY -->
    <section class="story" id="story">
      <div class="story-media" data-story-media>
        <img src={asset("img/store.webp")} alt={`محل ${site.fullName} في ${site.address}`} loading="lazy" width="960" height="640" />
        <div class="story-badge"><Logo size={34} /><span>{site.street}<br/><b>{site.address}</b></span></div>
      </div>
      <div class="story-copy">
        <span class="sec-num">04</span>
        <h2 class="sec-title reveal">محل حقيقي،<br/><span class="outline">ناس حقيقية</span></h2>
        <p class="reveal">العراقي مش مجرد صفحة أونلاين. ده محل في قلب السنطة بإدارة {site.manager}، بتدخله تلاقي الجهاز قدامك، تجرّبه، وتسأل براحتك. من اللابتوب لكاميرا المراقبة لراوتر البيت، بنختارلك اللي يناسبك ونقف جنبك بعد البيع.</p>
        <div class="stats">
          <div><b data-count="5.3" data-suffix="K">0</b><span>متابع بيثقوا فينا</span></div>
          <div><b data-count={services.length}>0</b><span>أقسام في محل واحد</span></div>
          <div><b data-count="100" data-suffix="%">0</b><span>أجهزة أصلية</span></div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact" id="contact">
      <div class="contact-card">
        <span class="sec-num">05</span>
        <h2 class="contact-title reveal">يلا نختار<br/><span class="gold">جهازك</span></h2>
        <p class="reveal">كلّمنا واتساب أو تعالى المحل، والرد بيكون بسرعة.</p>
        <div class="contact-actions">
          <a class="btn btn-gold btn-lg" target="_blank" rel="noopener" href={wa('أهلاً العراقي 👋')}>كلّمنا على واتساب</a>
          <a class="btn btn-ghost btn-lg" href={`tel:${site.phone.replace(/\s/g,'')}`}>اتصل <bdi dir="ltr">{site.phone}</bdi></a>
        </div>
        <ul class="contact-list">
          <li><span>العنوان</span><b>{site.address} — {site.street}</b></li>
          <li><span>الإيميل</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span>فيسبوك</span><a href={site.facebook} target="_blank" rel="noopener">{site.fullName}</a></li>
        </ul>
      </div>
      <div class="map">
        <iframe title="خريطة السنطة" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={`https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`}></iframe>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-giant" aria-hidden="true">{site.nameEn}</div>
    <div class="foot-row">
      <a href="#top" class="brand"><Logo size={34} /><span class="brand-txt"><b>{site.name}</b><small>للخدمات التكنولوجية</small></span></a>
      <span>© {new Date().getFullYear()} {site.fullName} — {site.address}</span>
    </div>
  </footer>


  <!-- quick view -->
  <dialog class="qv" data-qv>
    <button class="qv-close" data-qv-close aria-label="قفل">✕</button>
    <div class="qv-media"><img data-qv-img alt="" /></div>
    <div class="qv-info">
      <span class="card-brand" data-qv-brand></span>
      <h3 data-qv-name></h3>
      <span class="card-model" data-qv-model></span>
      <div class="card-tags" data-qv-tags></div>
      <p class="qv-cat" data-qv-cat></p>
      <div class="qv-actions">
        <button class="btn btn-gold" data-qv-add>أضف للسلة</button>
        <a class="btn btn-ghost" data-qv-wa target="_blank" rel="noopener">اسأل على واتساب</a>
      </div>
    </div>
  </dialog>

  <!-- cart -->
  <button class="cart-fab" data-cart-open aria-label="السلة">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
    <b data-cart-count>0</b>
  </button>
  <aside class="cart" data-cart aria-label="سلة الطلبات">
    <div class="cart-head"><h3>سلة الطلب</h3><button data-cart-close aria-label="قفل">✕</button></div>
    <ul class="cart-list" data-cart-list></ul>
    <p class="cart-empty" data-cart-empty>السلة فاضية. ضيف منتجات من المتجر.</p>
    <div class="cart-foot">
      <p>هنرد عليك بالأسعار والمتاح على طول.</p>
      <a class="btn btn-gold btn-lg" data-cart-send target="_blank" rel="noopener">ابعت الطلب على واتساب</a>
    </div>
  </aside>
  <div class="scrim" data-scrim></div>

  <a class="wa-float" href={wa('أهلاً العراقي 👋')} target="_blank" rel="noopener" aria-label="واتساب">
    <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.3 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.4Z"/></svg>
  </a>

  <script is:inline define:vars={{ products }}>window.__PRODUCTS = products;</script>
  <script is:inline define:vars={{ catalog, catName, wa: site.whatsapp, base: B }}>window.__CATALOG = catalog.products; window.__CATNAME = catName; window.__WA = wa; window.__BASE = base;</script>
  <script src="../scripts/main.js"></script>
  <script src="../scripts/shop.js"></script>
</body>
</html>
